# Data Valo System — Frontend Environment Variables
# PRD §6.4 & IMPLEMENTATION_PLAN §1.6

# Backend base URL (used by server components and Next.js rewrites at build time)
BACKEND_URL=http://localhost:4000

# Canonical public site URL (metadata, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for on-demand cache revalidation (/internal/revalidate)
# Must match REVALIDATE_SECRET in the backend
REVALIDATE_SECRET=

# Optional: Cloudinary cloud name for direct thumbnail uploads (public value)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

