{
  "name": "datavalo-backend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "lint": "eslint src/ scripts/ tests/",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:architecture": "depcruise src scripts --config .dependency-cruiser.cjs",
    "ensure-indexes": "node scripts/ensure-indexes.js",
    "seed:content": "node scripts/seed-content.js",
    "seed:admin": "node scripts/seed-admin.js",
    "backup": "node scripts/backup.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "mongoose": "^8.9.5",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "dependency-cruiser": "^16.9.0",
    "eslint": "^9.18.0",
    "mongodb-memory-server": "^10.1.3",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "vitest": "^3.0.0"
  }
}

